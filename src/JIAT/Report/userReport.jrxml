            <staticText><reportElement x="6" y="0" width="49" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement><text><![CDATA[User ID]]></text></staticText>
            <staticText><reportElement x="55" y="0" width="150" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement><text><![CDATA[  User Name]]></text></staticText>
